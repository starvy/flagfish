# Copy to `.env` (git-ignored): `task env`.
#
# The Taskfile loads `.env` automatically and falls back to these same values, so a
# fresh checkout works with `task up && task migrate` and no .env at all.
#
# This file is authoritative: every FLAGFISH_* variable the binary reads is listed
# below with its meaning and built-in default. `flagfish env` prints the resolved
# config (password redacted) and exits non-zero if anything is wrong. Run it before
# a deploy, not after.
#
# NEVER commit a real .env. NEVER put a production secret in this file — the values
# here are dev-only examples.

# --- database ---------------------------------------------------------------
# The binary reads FLAGFISH_DATABASE_URL and accepts DATABASE_URL as an alias, which
# is what compose, CI and most hosting platforms set. Required; there is no default.
# Scheme must be postgres:// or postgresql:// (Postgres 17 only) and must name a
# database. In production drop `sslmode=disable` and require TLS to the database.
DATABASE_URL=postgres://flagfish:flagfish@localhost:5432/flagfish?sslmode=disable

# Matches compose.yaml's `postgres-test` service. The integration and concurrency
# suites TRUNCATE this database on every run. Never point it at :5432.
# Read by the test harness and Taskfile, not by the server itself.
TEST_DATABASE_URL=postgres://flagfish:flagfish@localhost:5433/flagfish_test?sslmode=disable

# --- object storage (challenge files) ---------------------------------------
# Challenge files are stored in S3-compatible object storage (AWS S3, MinIO, R2, …).
# Credentials come from the environment ONLY — never a file, never the config table.
# Leave these empty to run without file storage (upload/download are disabled and say
# so). Setting some-but-not-all is a boot error listing what's missing.
#
# FLAGFISH_S3_ENDPOINT=s3.amazonaws.com        # host:port, no scheme
# FLAGFISH_S3_BUCKET=flagfish-files
# FLAGFISH_S3_REGION=us-east-1                  # default: us-east-1
# FLAGFISH_S3_ACCESS_KEY=...
# FLAGFISH_S3_SECRET_KEY=...
# FLAGFISH_S3_USE_SSL=true                      # default: true; false for local MinIO over HTTP
# FLAGFISH_S3_PATH_STYLE=false                  # default: false; true for MinIO and most self-hosted

# Matches compose.yaml's `minio-test` service. The integration suite exercises the real
# S3 backend against this. Read by the test harness and Taskfile, not by the server.
TEST_S3_ENDPOINT=localhost:9002
TEST_S3_BUCKET=flagfish-test
TEST_S3_ACCESS_KEY=flagfishtest
TEST_S3_SECRET_KEY=flagfishtest123

# --- server -----------------------------------------------------------------
# Listen address. host:port, or :port to bind all interfaces. (default: :8000)
FLAGFISH_ADDR=:8000

# Comma-separated CIDRs (or bare IPs) whose X-Forwarded-For we believe.
# Empty = trust nobody and use the socket peer address. (default: empty)
#
# LEAVING THIS EMPTY BEHIND A REVERSE PROXY BREAKS TWO THINGS, AND NEITHER IS VISIBLE
# UNTIL IT MATTERS:
#   1. Every request is attributed to the proxy's own address. The anonymous rate limiter
#      keys on that address, so the ENTIRE INTERNET shares one bucket — one stranger can
#      rate-limit /login for everybody.
#   2. submissions.ip records the proxy, not the player, which poisons the anti-cheat
#      evidence you only look at once you already need it.
# The server logs a WARNING at boot when this is empty, and again the first time a request
# arrives with X-Forwarded-For. A malformed entry is a hard startup error, not a skipped one.
#
# Behind a reverse proxy, set this to the proxy's address(es), e.g. 10.0.0.0/8 or 172.18.0.1.
# Empty is correct ONLY when nothing sits in front of the app (a laptop).
FLAGFISH_TRUSTED_PROXIES=

# Mark the session cookie Secure. (default: true)
#
# Independent of the proxy list on purpose: TLS is normally terminated by a proxy that
# speaks plain HTTP to us, so "did this request arrive over TLS" is the wrong question and
# answering it wrong hands out a session cookie a browser will send over plain HTTP.
# Leave it true in every deployment reachable over https://. Set it to false ONLY to serve
# the app over plain http:// yourself — i.e. this file, on a laptop. TLS (or a trusted
# X-Forwarded-Proto: https) forces Secure back on regardless.
FLAGFISH_SECURE_COOKIES=false

# Largest multipart upload accepted, in bytes. (default: 33554432 — 32 MiB)
# Every other request body is capped at 1 MiB and is not configurable. Over the cap is a
# 413, not an OOM.
# FLAGFISH_MAX_UPLOAD_BYTES=33554432

# --- rate limiting ----------------------------------------------------------
# Requests one caller may make per window before the limiter denies. Process-level
# on purpose: a brute-force guard an admin can turn down from the UI is one an
# attacker turns down first. Must be a positive integer. (default: 60)
FLAGFISH_RATE_LIMIT=60

# The window over which FLAGFISH_RATE_LIMIT is counted. Go duration (e.g. 1m, 30s,
# 500ms). Must be positive. (default: 1m)
FLAGFISH_RATE_WINDOW=1m

# --- logging ----------------------------------------------------------------
# debug | info | warn | error   (default: info)
FLAGFISH_LOG_LEVEL=debug
# text | json                   (default: json). Use json in production.
FLAGFISH_LOG_FORMAT=text

# --- observability ----------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
