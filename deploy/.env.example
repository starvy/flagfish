# Deployment environment for deploy/compose.yaml.
#
# Copy to deploy/.env (git-ignored) and fill in the secrets:
#   cp deploy/.env.example deploy/.env
#
# The secrets below are deliberately EMPTY, not "change-me": compose refuses to start on an
# empty value, so a copied-and-forgotten file fails at boot instead of running a public CTF
# on a password that is printed in this repository. Generate them, e.g.:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> deploy/.env
#
# NEVER commit deploy/.env.
#
# Only variables compose.yaml actually references reach the container: this file feeds
# compose's variable substitution, it is not injected wholesale. It is therefore a subset of
# the process-level surface — docs/ops/environment.md is the exhaustive list.

# --- Postgres ---------------------------------------------------------------
# The app DSN is derived from these in compose.yaml; you do not set DATABASE_URL here.
POSTGRES_USER=flagfish
POSTGRES_DB=flagfish
# REQUIRED — compose refuses to start on an empty value. Use a long random string.
POSTGRES_PASSWORD=

# --- MinIO / object storage -------------------------------------------------
# These are the MinIO root credentials AND the app's S3 credentials (the app talks to
# minio:9000 on the compose network). REQUIRED, and compose refuses to start on an empty
# value. The access key must be >= 3 chars and the secret >= 8.
MINIO_ROOT_USER=flagfish
MINIO_ROOT_PASSWORD=
# Bucket the app stores challenge files in. minio-init creates it on first run.
FLAGFISH_S3_BUCKET=flagfish-files

# --- app --------------------------------------------------------------------
# Host port to publish the app on (container always listens on :8000). Put a TLS
# reverse proxy in front of this; the app itself serves plaintext HTTP.
FLAGFISH_HTTP_ADDR=8000

# json in production; text is easier to read in a terminal.
FLAGFISH_LOG_FORMAT=json
FLAGFISH_LOG_LEVEL=info

# Behind a reverse proxy this MUST be the proxy's address(es) — comma-separated CIDRs or
# IPs. Leaving it empty behind a proxy is NOT harmless:
#   * every request presents the proxy's address, so the anonymous rate limiter sees the
#     entire internet as ONE client and a single stranger can lock everyone out of /login;
#   * submissions.ip records the proxy, not the player, so the anti-cheat evidence is junk.
# The app WARNS at boot when this is empty, and again on the first X-Forwarded-For it sees.
# Empty is correct only when nothing sits in front of the app.
# In this compose topology the proxy is whatever forwards to FLAGFISH_HTTP_ADDR, e.g.:
#   FLAGFISH_TRUSTED_PROXIES=172.16.0.0/12
FLAGFISH_TRUSTED_PROXIES=

# The announcement webhook may only reach public addresses: the URL is admin-settable, so the
# worker refuses to dial loopback, link-local (169.254.169.254 and friends), and private space,
# and it does not follow redirects. To post to a receiver on your own private network, name that
# receiver's network here — the network, not a blanket range, so the metadata endpoint stays out.
#   FLAGFISH_WEBHOOK_ALLOWED_NETWORKS=10.0.5.0/24
FLAGFISH_WEBHOOK_ALLOWED_NETWORKS=

# Session cookies are marked Secure by default, which is what an https:// deployment needs
# and does not depend on the proxy list above. Set this to false ONLY if you are serving
# the app over plain http:// on purpose — a browser will then send the session cookie in
# the clear.
# FLAGFISH_SECURE_COOKIES=true

# Largest multipart upload accepted, in bytes (default 32 MiB). Every other body is capped
# at 1 MiB. Keep this well under the container's memory limit in compose.yaml.
# FLAGFISH_MAX_UPLOAD_BYTES=33554432

# Per-caller rate limit: requests per window before the limiter denies.
FLAGFISH_RATE_LIMIT=60
FLAGFISH_RATE_WINDOW=1m

# The credential routes (login, register, reset) carry their own budgets in the same window,
# keyed so that a shared outbound address is never penalised: FLAGFISH_AUTH_RATE_LIMIT
# (default 10) is failed attempts against ONE account or token, from anywhere;
# FLAGFISH_AUTH_IP_FAILURE_LIMIT (default 60) is failed attempts from one address;
# FLAGFISH_AUTH_IP_RATE_LIMIT (default 300) is all credential traffic from one address.
# compose.yaml forwards all three.

# The app image `task deploy-up` pulls. Defaults to the published :latest; pin it to a
# version tag (e.g. ghcr.io/starvy/flagfish:v0.1.0) for a reproducible deploy.
# FLAGFISH_IMAGE=ghcr.io/starvy/flagfish:latest
# Build version stamp — only consulted when building from source (task deploy-up-build).
# FLAGFISH_VERSION=dev

# --- E2E only (used by deploy/compose.e2e.yaml) -----------------------------
# Host port Postgres is published on for the black-box test harness's out-of-band setup.
E2E_PG_PORT=55432
