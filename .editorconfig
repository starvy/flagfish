root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
# gofumpt owns Go formatting. This just stops an editor fighting it.
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,html}]
indent_size = 2

[go.mod]
indent_style = tab
